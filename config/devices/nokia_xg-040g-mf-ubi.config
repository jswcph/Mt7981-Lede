CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7583=y
CONFIG_TARGET_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi=y

# 强制禁用无线：Nokia XG-040G 无无线硬件（本机型没有 WiFi 芯片）
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7916 is not set
# CONFIG_PACKAGE_kmod-mt7996 is not set
# CONFIG_PACKAGE_kmod-mt7996-firmware is not set

# ============================================================
# USB 主机控制器
# kmod 只有插上设备时才会加载，对空闲内存几乎无影响
# ============================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
# usbutils：提供 lsusb 命令，方便查看已插入的 USB 设备
CONFIG_PACKAGE_usbutils=y

# ============================================================
# USB 存储（U盘 / 移动硬盘）
# ============================================================
# 基础 USB 存储驱动
CONFIG_PACKAGE_kmod-usb-storage=y
# 额外存储芯片支持（某些移动硬盘需要）
CONFIG_PACKAGE_kmod-usb-storage-extras=y
# UAS 协议，提升 USB3 硬盘读写性能
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# 自动挂载框架（插上硬盘/U盘后自动挂载到 /mnt）
CONFIG_PACKAGE_block-mount=y

# ----- 文件系统（按需保留，不需要的可注释掉）-----
# ext4：Linux 常用，推荐作为 NAS 硬盘格式（内核态，省内存）
CONFIG_PACKAGE_kmod-fs-ext4=y
# vfat：U盘默认格式（FAT32）
CONFIG_PACKAGE_kmod-fs-vfat=y
# exfat：大容量 U盘 / 部分移动硬盘常用
CONFIG_PACKAGE_kmod-fs-exfat=y
# ntfs3：Windows NTFS 内核驱动（比 ntfs-3g 更省内存）
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# ntfs-3g：用户态 NTFS（兼容性更好，但挂载后占内存；有 ntfs3 可酌情去掉）
CONFIG_PACKAGE_ntfs-3g=y
# 字符编码（中文文件名需要）
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-cp936=y

# ----- 磁盘工具（仅管理磁盘时用，不常驻内存，闪存无所谓可保留）-----
# e2fsprogs：格式化/检查 ext4
CONFIG_PACKAGE_e2fsprogs=y
# fdisk / lsblk / parted：分区与查看磁盘
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y

# ============================================================
# USB 网卡（USB 转 RJ45 有线网卡）
# 不接这类设备可整段注释掉以减小固件，对运行内存影响很小
# ============================================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
# Realtek USB 网卡
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
# ASIX USB 网卡
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
# NCM / MBIM（部分 USB 网卡 / 调制解调器）
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y

# ============================================================
# CPE / 4G/5G 上网卡自动识别
# 插上常见 4G/5G 棒后可在「网络 → 接口」里用 QMI/NCM/MBIM 建接口
# ============================================================
# QMI 驱动（目前最主流的 4G/5G 模组协议）
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
# USB 串口（很多模组需要 AT 口 / option 驱动）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
# 自动切换模组模式（从存储模式切到网卡模式）
CONFIG_PACKAGE_usb-modeswitch=y
# QMI 用户态工具 + LuCI 协议支持
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
# NCM / MBIM 协议支持（部分模组用）
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-mbim=y
# comgt：部分老式 NCM 模组辅助脚本
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y

# ============================================================
# NAS / 局域网文件共享（省内存方案）
# 用 ksmbd 替代 samba4：内核态 SMB，空闲和传输时内存占用都更低
# 日常 Windows / 安卓 / 大部分 Linux 共享足够；不需要 AD/复杂权限
# ============================================================
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
# Windows 网络邻居发现
CONFIG_PACKAGE_wsdd2=y
# 添加/管理共享用户（ksmbd.adduser）
CONFIG_PACKAGE_ksmbd-utils=y
