# H3C Magic NX30 Pro
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_h3c_magic-nx30-pro=y

# H3C NX30 Pro：保留基础系统和 Argon 主题，移除附加插件及其专属核心
# CONFIG_PACKAGE_luci-app-uugamebooster is not set
# CONFIG_PACKAGE_uugamebooster is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set

# PassWall 与核心
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_v2ray-core is not set

# OpenClash 与其专属依赖
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-i18n-openclash-zh-cn is not set
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_kmod-inet-diag is not set
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_ip-full is not set
# CONFIG_PACKAGE_coreutils is not set
# CONFIG_PACKAGE_coreutils-nohup is not set
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_curl is not set
# CONFIG_PACKAGE_ca-bundle is not set

# OpenClash Meta 核心不随 NX30 Pro 镜像写入
