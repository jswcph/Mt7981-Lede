#=================================================
# base.config - Nokia XG-040G 通用配置
#=================================================

# ---------- 基础 LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_zoneinfo-asia=y

# ---------- APK 软件包管理器（ImmortalWrt 25.10 master） ----------
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-openssl=y
# CONFIG_PACKAGE_opkg is not set
# CONFIG_PACKAGE_luci-app-opkg is not set
# CONFIG_PACKAGE_luci-i18n-opkg-zh-cn is not set

# ---------- LuCI 软件包管理器 ----------
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ---------- Argon 主题及设置面板 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- iStore：彻底不安装 ----------
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-lib-taskd is not set
# CONFIG_PACKAGE_luci-lib-xterm is not set
# CONFIG_PACKAGE_taskd is not set

# ---------- Passwall ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
# CONFIG_PACKAGE_v2ray-geoip=y
# CONFIG_PACKAGE_v2ray-geosite=y
# CONFIG_PACKAGE_chinadns-ng=y
# CONFIG_PACKAGE_dns2socks=y
# CONFIG_PACKAGE_ipt2socks=y
# CONFIG_PACKAGE_microsocks=y
# CONFIG_PACKAGE_tcping=y
# CONFIG_PACKAGE_trojan-plus=y
# CONFIG_PACKAGE_simple-obfs=y

# ---------- OpenClash ----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# ---------- USB / 自动挂载 ----------
CONFIG_PACKAGE_luci-app-usb-mount=y

# ---------- ZRAM ----------
CONFIG_PACKAGE_zram-swap=y

#=================================================
# 常用可选插件
# 删除下面对应行开头的 # 即可启用
# 默认全部关闭，不影响当前固件
#=================================================

# ---------- 网络 ----------
# 网络带宽监控：统计各主机/接口流量
# CONFIG_PACKAGE_luci-app-nlbwmon=y
# 网络唤醒 WOL：通过路由器唤醒局域网设备
CONFIG_PACKAGE_luci-app-wol=y
# UPnP：自动端口映射，适合部分游戏/应用
# CONFIG_PACKAGE_luci-app-upnp=y
# 多 WAN / 故障切换 / 负载均衡
# CONFIG_PACKAGE_luci-app-mwan3=y
# SQM：智能队列，降低高负载时网络延迟
# CONFIG_PACKAGE_luci-app-sqm=y

# ---------- DNS / 广告过滤 ----------
# Adblock：DNS 广告及跟踪域名过滤
# CONFIG_PACKAGE_luci-app-adblock=y
# Adblock Fast：轻量 DNS 广告过滤
# CONFIG_PACKAGE_luci-app-adblock-fast=y
# Unbound：独立 DNS 递归解析器
# CONFIG_PACKAGE_luci-app-unbound=y
# NextDNS：NextDNS 服务配置
# CONFIG_PACKAGE_luci-app-nextdns=y

# ---------- DDNS / HTTPS ----------
# DDNS：公网动态 IP 自动更新域名
CONFIG_PACKAGE_luci-app-ddns=y
# ACME：自动申请/续期 HTTPS 证书
# CONFIG_PACKAGE_luci-app-acme=y

# ---------- 系统维护 ----------
# Advanced Reboot：提供高级重启相关选项
# CONFIG_PACKAGE_luci-app-advanced-reboot=y
# Watchcat：网络异常检测及自动恢复
# CONFIG_PACKAGE_luci-app-watchcat=y
# Attended Sysupgrade：LuCI 在线升级辅助
# CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

# ---------- 存储 / USB ----------
# DiskMan：磁盘、分区及挂载管理
# CONFIG_PACKAGE_luci-app-diskman=y
# CIFS Mount：挂载 SMB/CIFS 网络共享
# CONFIG_PACKAGE_luci-app-cifs-mount=y
# NFS：NFS 网络文件共享管理
# CONFIG_PACKAGE_luci-app-nfs=y
# MiniDLNA：DLNA 媒体服务器
# CONFIG_PACKAGE_luci-app-minidlna=y
# USB Printer：USB 打印机共享
# CONFIG_PACKAGE_luci-app-usb-printer=y

# ---------- 网络共享 ----------
# Samba4：Windows/Linux 局域网文件共享
# CONFIG_PACKAGE_luci-app-samba4=y
# VSFTPD：FTP 文件服务器
# CONFIG_PACKAGE_luci-app-vsftpd=y

# ---------- VPN / 异地组网 ----------
# ZeroTier：虚拟局域网/异地组网
# CONFIG_PACKAGE_luci-app-zerotier=y
# OpenVPN：OpenVPN 客户端/服务端管理
# CONFIG_PACKAGE_luci-app-openvpn=y
# OpenConnect/ocserv：企业 VPN 相关
# CONFIG_PACKAGE_luci-app-ocserv=y

# ---------- WireGuard ----------
# WireGuard 用户空间工具
# CONFIG_PACKAGE_wireguard-tools=y
# WireGuard 内核模块
# CONFIG_PACKAGE_kmod-wireguard=y
# WireGuard LuCI 协议支持
# CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------- 系统 / 网络监控 ----------
# vnStat2：长期网络流量统计
# CONFIG_PACKAGE_luci-app-vnstat2=y
# Netdata：系统性能实时监控
# CONFIG_PACKAGE_luci-app-netdata=y

# ---------- Web / 调试 ----------
# TTYD：浏览器 Web 终端
# CONFIG_PACKAGE_luci-app-ttyd=y
# Commands：LuCI 中执行自定义命令
# CONFIG_PACKAGE_luci-app-commands=y

# ---------- IPTV / 组播 ----------
# OMC Proxy：IPTV/组播代理
# CONFIG_PACKAGE_luci-app-omcproxy=y
# UDPxy：UDP 组播转 HTTP 单播
# CONFIG_PACKAGE_luci-app-udpxy=y

# ---------- 精简无用组件 ----------
# CONFIG_PACKAGE_kmod-sound-core is not set
# CONFIG_PACKAGE_kmod-usb-audio is not set
# CONFIG_PACKAGE_kmod-video-core is not set
# CONFIG_PACKAGE_kmod-usb-printer is not set
# CONFIG_PACKAGE_kmod-bluetooth is not set
# CONFIG_PACKAGE_kmod-bluetooth-6lowpan is not set
# CONFIG_PACKAGE_kmod-fs-hfsplus is not set
# CONFIG_PACKAGE_kmod-fs-xfs is not set
# CONFIG_PACKAGE_kmod-fs-btrfs is not set
# CONFIG_PACKAGE_kmod-can is not set
# CONFIG_PACKAGE_luci-ssl is not set

CONFIG_KERNEL_LOG_BUF_SHIFT=15
