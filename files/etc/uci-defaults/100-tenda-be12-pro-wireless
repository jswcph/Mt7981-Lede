#!/bin/sh
# Tenda BE12 Pro (MT7987A / MT7992E) 专用首次启动无线配置
# 仅在本机型执行，不影响其他设备。
BOARD="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
[ "$BOARD" = "tenda,be12-pro" ] || exit 0

# MT7992E 在本设备上由同一 PCI 设备提供两个独立 radio。
# 复用系统生成的 PCI path，避免写死不同内核/驱动下可能变化的路径。
RADIO_PATH="$(uci -q get wireless.radio0.path)"
if [ -z "$RADIO_PATH" ]; then
    RADIO_PATH="$(uci -q show wireless | sed -n "s/^wireless\.[^.]*\.path='\(.*\)'$/\1/p" | head -n 1)"
fi
if [ -z "$RADIO_PATH" ]; then
    logger -t be12-pro-wireless "找不到 MT7992E PCI path，保留脚本等待下次启动重试"
    exit 1
fi

# 保留系统原有国家码；若默认配置没有国家码，则使用当前已验证可工作的 US。
COUNTRY="$(uci -q get wireless.radio0.country)"
[ -n "$COUNTRY" ] || COUNTRY="US"

# Radio 0：2.4GHz
uci set wireless.radio0='wifi-device'
uci set wireless.radio0.type='mac80211'
uci set wireless.radio0.path="$RADIO_PATH"
uci set wireless.radio0.radio='0'
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='1'
uci set wireless.radio0.htmode='EHT20'
uci set wireless.radio0.country="$COUNTRY"
uci set wireless.radio0.disabled='0'

# Radio 1：5GHz
uci set wireless.radio1='wifi-device'
uci set wireless.radio1.type='mac80211'
uci set wireless.radio1.path="$RADIO_PATH"
uci set wireless.radio1.radio='1'
uci set wireless.radio1.band='5g'
uci set wireless.radio1.channel='36'
uci set wireless.radio1.htmode='EHT160'
uci set wireless.radio1.country="$COUNTRY"
uci set wireless.radio1.disabled='0'

# 2.4GHz AP
uci set wireless.default_radio0='wifi-iface'
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.ssid='OpenWrt_2.4G'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key='password'
uci set wireless.default_radio0.disabled='0'

# 5GHz AP
uci set wireless.default_radio1='wifi-iface'
uci set wireless.default_radio1.device='radio1'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.network='lan'
uci set wireless.default_radio1.ssid='OpenWrt_5G'
uci set wireless.default_radio1.encryption='psk2'
uci set wireless.default_radio1.key='password'
uci set wireless.default_radio1.disabled='0'

uci commit wireless
logger -t be12-pro-wireless "BE12 Pro 双频无线配置已写入"
exit 0
