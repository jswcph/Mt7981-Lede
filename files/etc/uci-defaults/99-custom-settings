#!/bin/sh
# 首次开机自动执行一次：写入主机名/LAN地址/WiFi名称/默认密码/主题/语言

# 主机名
uci set system.@system[0].hostname='OpenWrt'

# LAN 地址
uci set network.lan.ipaddr='192.168.6.1'

# WiFi SSID（按接口是否存在自动匹配，避免单频设备报错）
[ -n "$(uci -q get wireless.@wifi-iface[0])" ] && uci set wireless.@wifi-iface[0].ssid='OpenWrt_2.4G'
[ -n "$(uci -q get wireless.@wifi-iface[1])" ] && uci set wireless.@wifi-iface[1].ssid='OpenWrt_5G'

# 默认密码：password
(echo 'password'; sleep 1; echo 'password') | passwd root >/dev/null 2>&1

# 默认主题：Argon
uci set luci.main.mediaurlbase='/luci-static/argon'

# 默认语言：简体中文
uci set luci.main.lang='zh_cn'

uci commit system
uci commit network
uci commit wireless
uci commit luci

exit 0
