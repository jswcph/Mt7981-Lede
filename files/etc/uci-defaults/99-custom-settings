#!/bin/sh
# 首次开机自动执行一次：写入主机名/LAN地址/网口分配/WiFi名称/默认密码/主题/语言
# 主机名
uci set system.@system[0].hostname='OpenWrt'
# 缩小系统日志内存缓冲区（默认64，纯路由+科学上网场景32~48够用，省内存）
uci set system.@system[0].log_size='32'

# 网口：lan1 = WAN，lan2/lan3/lan4 = LAN
# Nokia XG-040G-MD/MF 的 ImmortalWrt board.d 默认将 lan1~lan4 放入 LAN，
# 这里覆盖为 lan1=WAN、lan2~lan4=LAN。
uci -q delete network.wan
uci set network.wan='interface'
uci set network.wan.device='lan1'
uci set network.wan.proto='dhcp'

uci -q delete network.lan
uci set network.lan='interface'
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.6.1'
uci set network.lan.netmask='255.255.255.0'

uci -q delete network.br_lan
uci set network.br_lan='device'
uci set network.br_lan.type='bridge'
uci add_list network.br_lan.ports='lan2'
uci add_list network.br_lan.ports='lan3'
uci add_list network.br_lan.ports='lan4'

# WiFi SSID + 密码（按接口是否存在自动匹配，避免单频设备报错）
if [ -n "$(uci -q get wireless.@wifi-iface[0])" ]; then
    uci set wireless.@wifi-iface[0].ssid='OpenWrt_2.4G'
    uci set wireless.@wifi-iface[0].encryption='psk2'
    uci set wireless.@wifi-iface[0].key='password'
fi
if [ -n "$(uci -q get wireless.@wifi-iface[1])" ]; then
    uci set wireless.@wifi-iface[1].ssid='OpenWrt_5G'
    uci set wireless.@wifi-iface[1].encryption='psk2'
    uci set wireless.@wifi-iface[1].key='password'
fi

# 5G 频段默认开启 160MHz 带宽
# 优先按 band=5g 判断具体是哪个 wifi-device，避免设备顺序不固定导致设错频段
for dev in $(uci -q show wireless | grep '=wifi-device' | cut -d. -f2 | cut -d= -f1); do
    band="$(uci -q get wireless.${dev}.band)"
    if [ "$band" = "5g" ]; then
        cur_htmode="$(uci -q get wireless.${dev}.htmode)"
        case "$cur_htmode" in
            HE*)  uci set wireless.${dev}.htmode='HE160' ;;
            EHT*) uci set wireless.${dev}.htmode='EHT160' ;;
            *)    uci set wireless.${dev}.htmode='VHT160' ;;
        esac
    fi
done

# 默认密码：password（登录/SSH）
(echo 'password'; sleep 1; echo 'password') | passwd root >/dev/null 2>&1

# 默认主题：Argon
uci set luci.main.mediaurlbase='/luci-static/argon'
# 默认语言：简体中文
uci set luci.main.lang='zh_cn'

uci commit system
uci commit network
uci commit wireless
uci commit luci
exit 0
