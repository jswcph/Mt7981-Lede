#!/bin/sh
# 首次开机自动执行一次：写入主机名/LAN地址/WiFi名称/默认密码/主题/语言
# 主机名
uci set system.@system[0].hostname='OpenWrt'
# 缩小系统日志内存缓冲区（默认64，纯路由+科学上网场景32~48够用，省内存）
uci set system.@system[0].log_size='32'
# LAN 地址
uci set network.lan.ipaddr='192.168.6.1'

# 默认密码：password（登录/SSH）
(echo 'password'; sleep 1; echo 'password') | passwd root >/dev/null 2>&1

# 默认主题：Argon
uci set luci.main.mediaurlbase='/luci-static/argon'
# 默认语言：简体中文
uci set luci.main.lang='zh_cn'

uci commit system
uci commit network
uci commit luci
exit 0
