#!/bin/sh
#=================================================
# Nokia XG-040G-MD/MF 首次启动网络设置
#
# 默认：
#   光口 / 默认 WAN -> wan
#   lan1/lan2/lan3/lan4 -> br-lan
#
# 修改为：
#   lan1 -> WAN
#   lan2/lan3/lan4 -> LAN（br-lan）
#=================================================

# 只有网络配置存在时才执行
[ -f /etc/config/network ] || exit 0

. /lib/functions.sh

BR_LAN_SECTION=""

# 找到 name='br-lan' 的 device 段
find_br_lan() {
    local section="$1"
    local name

    config_get name "$section" name

    if [ "$name" = "br-lan" ]; then
        BR_LAN_SECTION="$section"
    fi
}

config_load network
config_foreach find_br_lan device

if [ -z "$BR_LAN_SECTION" ]; then
    echo "[99-custom-settings] ERROR: 未找到 br-lan device 配置"
    exit 1
fi

echo "[99-custom-settings] 找到 br-lan：$BR_LAN_SECTION"

#=================================================
# 1. br-lan 只保留 lan2 / lan3 / lan4
#=================================================

uci -q delete "network.${BR_LAN_SECTION}.ports"

uci add_list "network.${BR_LAN_SECTION}.ports=lan2"
uci add_list "network.${BR_LAN_SECTION}.ports=lan3"
uci add_list "network.${BR_LAN_SECTION}.ports=lan4"

#=================================================
# 2. LAN 接口使用 br-lan
#=================================================

uci -q set network.lan.device='br-lan'

#=================================================
# 3. WAN 接口改为 lan1
#=================================================

uci -q set network.wan.device='lan1'

# 如果系统存在 wan6，也同步改到 lan1，避免 IPv6 仍使用旧 WAN 物理口
if uci -q get network.wan6 >/dev/null 2>&1; then
    uci -q set network.wan6.device='lan1'
fi

#=================================================
# 4. 保存网络配置
#=================================================

uci commit network

#=================================================
# 5. 最终检查
#=================================================

echo "==============================================="
echo "Nokia XG-040G 首次启动网络配置完成"
echo "==============================================="
echo "WAN  -> lan1"
echo "LAN  -> lan2 lan3 lan4"
echo "==============================================="

echo ">>> WAN："
uci -q get network.wan.device || true

echo ">>> WAN6："
uci -q get network.wan6.device 2>/dev/null || true

echo ">>> br-lan："
uci -q show "network.${BR_LAN_SECTION}.ports" || true

# 网络配置已经写入，交由首次启动流程继续处理网络重载
exit 0
